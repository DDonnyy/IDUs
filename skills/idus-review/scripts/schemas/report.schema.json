{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDUs review report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "toolkit_version", "mode", "summary", "documents", "coverage", "findings", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "toolkit_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mode": {"enum": ["audit", "edit"]},
    "summary": {"$ref": "#/$defs/text"},
    "configuration_revision": {"type": ["integer", "null"], "minimum": 0},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "scope", "status", "limitations"],
      "properties": {
        "document_id": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"},
        "status": {"enum": ["reviewed", "partial", "not_checked"]},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["locator", "detail"],
      "properties": {"locator": {"$ref": "#/$defs/text"}, "detail": {"$ref": "#/$defs/text"}}
    },
    "anchor": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["path", "old", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "old": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "document_id", "location", "category", "priority", "confidence", "original", "proposal", "rule_ids", "reason", "wording_verdict", "evidence_status", "evidence_dependent", "evidence", "authorisation", "application_status", "source_anchor"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "document_id": {"$ref": "#/$defs/text"},
        "location": {"$ref": "#/$defs/text"},
        "category": {"enum": ["LANGUAGE", "STRUCTURE", "EVIDENCE", "CONTENT", "STYLE"]},
        "priority": {"enum": ["high", "medium", "low", "optional"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "original": {"$ref": "#/$defs/text"}, "proposal": {"type": ["string", "null"]},
        "rule_ids": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
        "reason": {"$ref": "#/$defs/text"},
        "wording_verdict": {"enum": ["ACCEPT", "ACCEPT WITH FIX", "REJECT", "NEEDS EVIDENCE", "AUTHOR DECISION"]},
        "evidence_status": {"enum": ["VERIFIED", "NOT CHECKED", "UNAVAILABLE", "CONTRADICTED"]},
        "evidence_dependent": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "authorisation": {"$ref": "#/$defs/text"},
        "application_status": {"enum": ["proposed", "applied", "skipped", "rejected"]},
        "source_anchor": {"$ref": "#/$defs/anchor"}
      }
    }
  }
}
