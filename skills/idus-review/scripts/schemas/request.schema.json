{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDUs review request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "documents", "scope"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["audit", "edit"]},
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "input"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
          "kind": {"enum": ["text", "path"]},
          "input": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "workspace": {"type": ["string", "null"], "minLength": 1},
    "report_language": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "configuration": {"type": ["string", "null"], "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  }
}
